{
  "name": "poli-design-system",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build @poli/components",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint src --ext .ts,.html",
    "lint:fix": "eslint src --ext .ts,.html --fix",
    "storybook": "ng run base-project:storybook",
    "build-storybook": "ng run base-project:build-storybook",
    "docs:start": "cd apps/docs && npm start",
    "docs:build": "cd apps/docs && npm run build",
    "tokens:sync": "npx ts-node -P scripts/tsconfig.json scripts/sync-tokens.ts",
    "tokens:audit": "npx ts-node -P scripts/tsconfig.json scripts/audit-contrast.ts",
    "generate:docs": "npx ts-node -P scripts/tsconfig.json scripts/generate-docs.ts",
    "semilla:start": "cd apps/semilla-front && ng serve",
    "semilla:build": "cd apps/semilla-front && ng build"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.4",
    "@angular/cdk": "^19.2.7",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.7",
    "@angular/material-moment-adapter": "^19.2.7",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "@tailwindcss/postcss": "^4.1.14",
    "bootstrap": "^5.3.3",
    "date-fns": "^4.1.0",
    "moment": "^2.30.1",
    "ngx-quill": "^27.1.2",
    "ngx-scrollbar": "^18.0.0",
    "normalize.css": "^8.0.1",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.14",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.5",
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular/cli": "^19.2.5",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/localize": "^19.2.4",
    "@compodoc/compodoc": "^1.1.26",
    "@figma/code-connect": "^1.4.3",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-onboarding": "^8.6.14",
    "@storybook/angular": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.19.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "chromatic": "^11.28.2",
    "eslint": "^10.2.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.0",
    "storybook": "^8.6.14",
    "typescript": "^5.3.3"
  }
}
