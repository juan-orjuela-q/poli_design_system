{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "@angular/localize"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "files": ["src/main.ts"],
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.json"
  ],
  "exclude": [
    "src/test.ts",
    "**/*.spec.ts"
  ]
}
